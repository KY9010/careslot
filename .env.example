# Copy this file to .env and fill in the values.
# Postgres connection string (pooled connection in production)
DATABASE_URL="postgresql://careslot:careslot@localhost:5433/careslot?schema=public"
# Optional: direct (unpooled) connection used for migrations in production
DATABASE_URL_UNPOOLED=""
# Long random string used to sign session cookies:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
# Public URL of the app (used for Stripe redirect URLs). Optional on Vercel: detected automatically.
APP_URL="http://localhost:3000"
# Stripe TEST-mode keys (sk_test_... and whsec_...). Leave empty to skip payments locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
